# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Gson supplies general @SerializedName rules. Keep only annotated members in the app's
# reflection-backed wire models so R8 may still rename and optimize their classes.
-keepclassmembers,allowobfuscation,allowoptimization class com.salattracker.data.backup.** {
    @com.google.gson.annotations.SerializedName <fields>;
}
-keepclassmembers,allowobfuscation,allowoptimization class com.salattracker.data.remote.api.** {
    @com.google.gson.annotations.SerializedName <fields>;
}
-keepclassmembers,allowobfuscation,allowoptimization class com.salattracker.notification.*Asset {
    @com.google.gson.annotations.SerializedName <fields>;
}
